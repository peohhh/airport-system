
<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: Arial, Helvetica, sans-serif;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 85px;
}

body {
  background: #f4f6f8;
  color: #263442;
  line-height: 1.7;
}

/* NAVIGATION */
nav {
  position: fixed;
  top: 0;
  width: 100%;
  background: #123354;
  padding: 17px 12px;
  text-align: center;
  z-index: 1000;
  border-bottom: 4px solid #f28c28;
  box-shadow: 0 3px 12px rgba(0, 0, 0, 0.15);
}

nav a {
  color: #ffffff;
  text-decoration: none;
  margin: 0 10px;
  font-size: 14px;
  font-weight: bold;
  transition: 0.3s;
}

nav a:hover {
  color: #ffad55;
}

/* PAGE SECTIONS */
.page {
  min-height: 100vh;
  padding: 110px 8% 65px;
}

section:nth-of-type(even):not(.hero) {
  background: #ffffff;
}

/* HERO SECTION */
.hero {
  background:
    linear-gradient(120deg,
      rgba(18, 51, 84, 0.97),
      rgba(28, 78, 119, 0.92),
      rgba(242, 140, 40, 0.88));
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: white;
}

.hero > div {
  max-width: 950px;
}

.profile-img {
  width: 175px;
  height: 175px;
  border-radius: 50%;
  border: 5px solid #ffffff;
  object-fit: cover;
  margin-bottom: 22px;
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.25);
}

.hero h1 {
  font-size: clamp(30px, 4vw, 45px);
  line-height: 1.25;
  margin-bottom: 18px;
  letter-spacing: 1px;
}

.hero h2 {
  color: #ffffff;
  border: none;
  padding: 0;
  margin-bottom: 18px;
}

.hero p {
  margin-bottom: 7px;
}

.hero strong {
  color: #ffd5a8;
}

/* BUTTONS */
.btn {
  display: inline-block;
  margin: 10px 6px;
  padding: 12px 24px;
  background: #f28c28;
  color: #ffffff;
  border: 2px solid #f28c28;
  border-radius: 6px;
  text-decoration: none;
  font-weight: bold;
  transition: 0.3s;
}

.btn:hover {
  background: #ffffff;
  color: #123354;
  border-color: #ffffff;
  transform: translateY(-2px);
}

/* HEADINGS */
h2 {
  color: #123354;
  margin-bottom: 28px;
  border-left: 6px solid #f28c28;
  padding-left: 14px;
  line-height: 1.4;
}

h3 {
  color: #174c78;
  margin-bottom: 12px;
}

/* CARDS */
.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  gap: 24px;
}

.card {
  background: #ffffff;
  padding: 27px;
  border-radius: 10px;
  border: 1px solid #dce4eb;
  border-top: 4px solid #f28c28;
  box-shadow: 0 5px 18px rgba(18, 51, 84, 0.07);
  transition: transform 0.3s, box-shadow 0.3s;
}

.card:hover {
  transform: translateY(-4px);
  box-shadow: 0 10px 25px rgba(18, 51, 84, 0.12);
}

.card h3 {
  color: #174c78;
}

/* OVERVIEW NUMBERS */
.kpi {
  font-size: 30px;
  color: #e77c16;
  font-weight: bold;
  margin-bottom: 8px;
}

/* SKILLS */
.skill {
  margin-bottom: 20px;
}

.bar {
  width: 100%;
  background: #e3e8ee;
  border-radius: 20px;
  overflow: hidden;
  height: 14px;
  margin-top: 6px;
}

.fill {
  height: 100%;
  background: linear-gradient(90deg, #174c78, #f28c28);
  border-radius: 20px;
}

/* CAREER TIMELINE */
.timeline {
  border-left: 4px solid #f28c28;
  padding-left: 25px;
}

.timeline-box {
  background: #ffffff;
  padding: 24px;
  margin-bottom: 24px;
  border-radius: 8px;
  border: 1px solid #dce4eb;
  border-left: 5px solid #174c78;
  box-shadow: 0 4px 15px rgba(18, 51, 84, 0.06);
}

.timeline-box h3 {
  color: #174c78;
}

.timeline-box ul {
  margin-top: 12px;
}

/* TABLE */
table {
  width: 100%;
  border-collapse: collapse;
  margin-top: 18px;
  background: #ffffff;
}

th, td {
  border: 1px solid #d5dee7;
  padding: 13px;
  text-align: left;
}

th {
  background: #123354;
  color: #ffffff;
}

tr:nth-child(even) {
  background: #f2f6fa;
}

/* PROJECT EVIDENCE */
.project img {
  display: block;
  width: 100%;
  height: 190px;
  object-fit: cover;
  border-radius: 7px;
  margin-bottom: 18px;
  border: 1px solid #dce4eb;
  background: #eef2f5;
}

/* LISTS */
ul {
  margin-left: 22px;
}

li {
  margin-bottom: 7px;
}

/* CONTACT SECTION */
.contact-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 22px;
  margin-top: 30px;
}

.contact-box {
  background: #ffffff;
  color: #263442;
  text-align: center;
  padding: 30px 20px;
  border-radius: 10px;
  border: 1px solid #dce4eb;
  border-bottom: 4px solid #f28c28;
  box-shadow: 0 5px 18px rgba(18, 51, 84, 0.07);
  transition: 0.3s;
}

.contact-box:hover {
  transform: translateY(-6px);
}

.contact-box .icon {
  font-size: 38px;
  margin-bottom: 15px;
}

.contact-box h3 {
  color: #123354;
  font-size: 14px;
  margin-bottom: 10px;
}

.contact-box p {
  color: #596777;
  font-size: 14px;
  overflow-wrap: anywhere;
}

.contact-box a {
  color: #175b94;
  text-decoration: none;
}

.contact-box a:hover {
  color: #e77c16;
  text-decoration: underline;
}

/* FOOTER */
footer {
  text-align: center;
  padding: 25px;
  background: #123354;
  color: #ffffff;
  border-top: 4px solid #f28c28;
}

/* RESPONSIVE DESIGN */
@media (max-width: 768px) {
  nav {
    padding: 12px 8px;
  }

  nav a {
    display: inline-block;
    margin: 5px 7px;
    font-size: 12px;
  }

  .page {
    padding: 100px 5% 50px;
  }

  .hero h1 {
    font-size: 30px;
  }

  .profile-img {
    width: 145px;
    height: 145px;
  }

  .card {
    padding: 20px;
  }

  table {
    font-size: 12px;
  }

  th, td {
    padding: 8px;
  }
}
</style>
